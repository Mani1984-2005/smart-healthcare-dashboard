# Part 3 — Medical Documents & OCR. Copy to .env or export in your shell. Every value is optional.
# Only PART3_* variables are read; no database, Firebase or other-module settings are needed.

PART3_PORT=5000                    # 5000 = the port the Vite dev proxy (/api -> localhost:5000) already targets
PART3_DATA_DIR=                    # default: backend/part3/.data ; use "memory" for nothing-on-disk
PART3_AUTH_MODE=demo               # only "demo" exists
PART3_DEMO_SECRET=                 # signs demo sessions; if empty a random per-process secret is used
PART3_SESSION_TTL_SECONDS=28800
PART3_ALLOW_DEMO_AUTH=             # must be "true" to start with NODE_ENV=production (demo auth is NOT real authentication)
PART3_MAX_UPLOAD_MB=10
PART3_OCR_PROVIDERS=synthetic-demo # comma list of enabled OCR provider ids
PART3_OCR_DEFAULT=                 # default provider id (first enabled if empty)
PART3_OCR_TIMEOUT_MS=30000
PART3_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # standalone server CORS allow-list
PART3_ENABLE_DEMO_RESET=           # default: true outside production

# Frontend (Vite) — only needed if the API is NOT reachable at /api/part3:
# VITE_PART3_API_BASE_URL=http://localhost:5001/part3
