# Part 6 (ABDM / FHIR / Consent / Security prototype) - copy to backend/.env and adjust. Never commit real values.

# Prototype modes. Only "demo" is implemented: there is NO live ABDM or FHIR-server connectivity.
# Any other value makes Part 6 refuse to start rather than imply a live integration.
ABDM_MODE=demo
FHIR_MODE=demo
FHIR_VERSION=4.0.1

# Session-token signing secret (>= 32 chars). If unset, an ephemeral per-process secret is generated
# (fine for a demo; sessions end on restart). REQUIRED when NODE_ENV=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PART6_TOKEN_SECRET=
PART6_TOKEN_TTL_SECONDS=3600

# Demo persona sign-in (no passwords). Defaults to true outside production; REFUSED when NODE_ENV=production.
PART6_DEMO_AUTH=true

# Storage for the part6_* collections: "file" (persists to backend/part6/.data) or "memory".
PART6_STORAGE=file
# PART6_DATA_DIR=

# Rate limits per client per minute (general / login)
PART6_RATE_LIMIT_MAX=600
PART6_LOGIN_RATE_LIMIT_MAX=20

# Standalone server only (backend/part6/server.js)
PART6_PORT=5000
PART6_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
