# SIH Part 4 — Clinical Intelligence. Every variable is OPTIONAL. With none set (and NODE_ENV != production)
# the module runs in demo mode: synthetic patients, deterministic rules, mock AI provider, no DB/Firebase/AI key needed.

# CLINICAL_DEMO_MODE=true            # default: true unless NODE_ENV=production
# CLINICAL_AUTH_MODE=demo            # demo | firebase   (default: demo in demo mode, firebase otherwise)
# CLINICAL_SESSION_SECRET=           # HMAC secret for demo sessions; random per process if unset (set it for multi-instance)
# CLINICAL_SESSION_TTL_SECONDS=3600
# CLINICAL_RATE_LIMIT_PER_MIN=30
# CLINICAL_MAX_BODY_BYTES=262144
# CLINICAL_MAX_STORED_ANALYSES=200

# AI provider: none | mock | anthropic     (default: mock in demo mode, none otherwise)
# CLINICAL_AI_PROVIDER=mock
# ANTHROPIC_API_KEY=                 # only used when CLINICAL_AI_PROVIDER=anthropic. Never returned or logged.
# CLINICAL_AI_MODEL=claude-sonnet-5
# CLINICAL_AI_TIMEOUT_MS=20000
