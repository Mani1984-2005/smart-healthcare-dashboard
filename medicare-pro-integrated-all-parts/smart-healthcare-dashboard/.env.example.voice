# SIH26047 Part 2 - Voice, Multilingual & Accessible Clinical Interaction
# Copy to .env (git-ignored) to change defaults. Every value is optional; with
# nothing set the module runs in "auto" mode (real browser speech when the
# browser supports it, otherwise demo mode with sample sentences).
#
# NEVER put API keys here: VITE_* values are bundled into the public frontend.
# Keys for a real translation service belong on a backend proxy.

# auto | live | demo
VITE_VOICE_DEFAULT_MODE=auto

# Speech recognition provider: browser | mock
VITE_VOICE_PROVIDER=browser

# Translation provider: http | mock
# Default is "http". With no endpoint configured, live mode shows a friendly
# "translation is not available" message and the original text stays usable.
# Demo mode always uses the built-in sample-sentence translator.
VITE_VOICE_TRANSLATION_PROVIDER=http

# Text-to-speech provider: browser | mock
VITE_VOICE_TTS_PROVIDER=browser

# URL of YOUR backend translation proxy (used when the provider above is "http").
# Receives POST {text, sourceLanguage, targetLanguage}, returns {translatedText, provider?}.
# VITE_VOICE_TRANSLATION_ENDPOINT=/api/voice/translate
