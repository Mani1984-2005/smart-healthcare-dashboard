# Copy to .env.production and fill in real values. Never commit the filled
# file — it holds database and signing secrets. See docs/DEPLOYMENT.md.

# --- Networking -------------------------------------------------------------
CLIENT_ORIGIN=https://medicare-pro.example-hospital.org
VITE_API_BASE_URL=/api
HTTP_PORT=8080

# --- Database -----------------------------------------------------------
PGUSER=medicare_app
PGPASSWORD=change-me-generate-a-strong-random-value
PGDATABASE=medicare_pro

# --- Auth -----------------------------------------------------------------
# 32+ byte random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me
KEYCLOAK_BASE_URL=https://auth.example-hospital.org
KEYCLOAK_REALM=medicare-pro
KEYCLOAK_CLIENT_ID=medicare-pro-backend

# --- Uploads / OCR ----------------------------------------------------------
MAX_FILE_SIZE_MB=15
OCR_LANG=eng
