{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run --exclude \"**/part6/**\" --exclude \"**/clinical-intelligence/**\" --exclude \"tests/physicianWorkspace.*.test.js\"",
    "test:physician-workspace": "node --test \"tests/physicianWorkspace.*.test.js\"",
    "part6:start": "node part6/server.js",
    "test:part6": "node --test \"part6/tests/*.test.js\"",
    "test:clinical-intelligence": "node --test \"clinical-intelligence/__tests__/*.test.js\"",
    "test:clinical-intelligence:unit": "node --test \"clinical-intelligence/__tests__/unit.*.test.js\"",
    "test:clinical-intelligence:integration": "node --test \"clinical-intelligence/__tests__/integration.*.test.js\"",
    "test:clinical-intelligence:safety": "node --test \"clinical-intelligence/__tests__/safety.test.js\"",
    "test:all": "npm run test && npm run test:physician-workspace && npm run test:part6 && npm run test:clinical-intelligence"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.1.0",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
