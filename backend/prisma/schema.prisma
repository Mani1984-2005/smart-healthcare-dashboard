generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id             Int             @id @default(autoincrement())
  name           String?         @db.VarChar(100)
  age            Int?
  gender         String?         @db.VarChar(10)
  phone          String?         @db.VarChar(15)
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  address        String?
  bloodGroup     String?
  email          String?
  medicalHistory String[]
  status         String          @default("Active")
  updatedAt      DateTime?       @updatedAt
  appointments   Appointment[]
  invoices       Invoice[]
  labTests       LabTest[]
  queues         Queue[]
  billing        billing[]
  lab_reports    lab_reports[]
  prescriptions  prescriptions[]
  intakeSessions    IntakeSession[]
  clinicalHistories ClinicalHistory[]
  encounters        Encounter[]
  prescriptionRecords Prescription[]

  @@map("patients")
}

model billing {
  id         Int       @id @default(autoincrement())
  patient_id Int?
  amount     Decimal?  @db.Decimal(10, 2)
  status     String?   @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  patients   Patient?  @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model doctors {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(100)
  specialization String?         @db.VarChar(100)
  phone          String?         @db.VarChar(15)
  email          String?         @db.VarChar(100)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  prescriptions  prescriptions[]
}

model lab_reports {
  id         Int       @id @default(autoincrement())
  patient_id Int?
  test_name  String?   @db.VarChar(100)
  result     String?
  file_url   String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  patients   Patient?  @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model prescriptions {
  id          Int       @id @default(autoincrement())
  patient_id  Int?
  doctor_id   Int?
  diagnosis   String?
  medicines   String?
  ai_analysis Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  doctors     doctors?  @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients    Patient?  @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Doctor {
  id             String        @id @default(uuid())
  name           String
  department     String
  specialization String
  phone          String?
  email          String?       @unique
  isAvailable    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  encounters     Encounter[]
}

model Appointment {
  id        String   @id @default(uuid())
  patientId Int
  doctorId  String
  date      DateTime
  timeSlot  String
  status    String   @default("SCHEDULED")
  reason    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
  queues    Queue[]
  encounter Encounter?

  @@unique([doctorId, date, timeSlot])
}

model Queue {
  id            String      @id @default(uuid())
  patientId     Int
  appointmentId String
  doctorId      String
  status        String      @default("WAITING")
  checkInTime   DateTime    @default(now())
  completedTime DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])
}

model Medicine {
  id                 String    @id @default(uuid())
  name               String
  genericName        String?
  category           String
  manufacturer       String?
  form               String?
  dosage             String?
  unit               String?
  stock              Int       @default(0)
  reorderLevel       Int       @default(10)
  price              Float     @default(0.0)
  unitPrice          Float?
  isPrescriptionOnly Boolean   @default(false)
  batchNumber        String?
  expiryDate         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  prescriptionItems  PrescriptionItem[]
}

model LabTest {
  id           String    @id @default(uuid())
  patientId    Int
  encounterId  String?
  testName     String
  testCategory String?
  priority     String    @default("NORMAL")
  status       String    @default("PENDING")
  result       String?
  notes        String?
  orderedBy    String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  patient      Patient   @relation(fields: [patientId], references: [id])
  encounter    Encounter? @relation(fields: [encounterId], references: [id])
}

model Invoice {
  id            String    @id @default(uuid())
  patientId     Int
  appointmentId String?
  encounterId   String?
  amount        Float
  tax           Float     @default(0)
  discount      Float     @default(0)
  total         Float?
  status        String    @default("UNPAID")
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  patient       Patient   @relation(fields: [patientId], references: [id])
  encounter     Encounter? @relation(fields: [encounterId], references: [id])
}

model Department {
  id          String  @id @default(uuid())
  name        String
  description String?
}

model Bed {
  id        String  @id @default(uuid())
  ward      String
  number    String
  status    String  @default("AVAILABLE")
  patientId String?
}

model Encounter {
  id            String    @id @default(uuid())
  appointmentId String?   @unique
  patientId     Int
  doctorId      String
  status        String    @default("IN_PROGRESS")
  chiefComplaint String?
  diagnosis     String?
  notes         String?
  vitalSigns    Json?
  anatomyData   Json?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patient       Patient   @relation(fields: [patientId], references: [id])
  doctor        Doctor    @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]
  labTests      LabTest[]
  invoices      Invoice[]
}

model Prescription {
  id            String    @id @default(uuid())
  patientId     Int
  doctorId      String
  encounterId   String?
  appointmentId String?
  notes         String?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  patient       Patient   @relation(fields: [patientId], references: [id])
  encounter     Encounter? @relation(fields: [encounterId], references: [id])
  items         PrescriptionItem[]
}

model PrescriptionItem {
  id             String    @id @default(uuid())
  prescriptionId String
  medicineId     String?
  medicineName   String?
  dosage         String?
  frequency      String?
  duration       String?
  quantity       Int       @default(0)
  instructions   String?
  createdAt      DateTime  @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine       Medicine?    @relation(fields: [medicineId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  userRole  String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// ===========================================================================
// SIH26047 — Phase 2 database foundation (ADDITIVE ONLY).
//
// These four models are the minimum persistence actually required by the
// existing SIH code today: Part 1 (AI Clinical Intake) is the only SIH part
// that already talks to PostgreSQL, through backend/sih/models/IntakeSession.js
// and backend/sih/models/ClinicalHistory.js, which read/write the snake_case
// tables/columns defined below. Parts 3/4/5/6 currently persist to
// in-memory/JSON stores and are intentionally NOT given database models in
// this phase (see docs/SIH26047_FINAL_INTEGRATION.md and the Phase 2 report).
//
// No MediCare Pro model above this line is renamed, redesigned, or removed.
// `patientId` uses Int because MediCare Pro Patient.id is Int (serial): the
// earlier reference SQL stored patient_id as TEXT only because that type was
// unverified at the time; it is now verified, so the correct compatible type
// is used and no duplicate patient table is introduced.
// ===========================================================================

model IntakeSession {
  id                String    @id @db.Uuid
  patientId         Int       @map("patient_id")
  encounterId       String?   @map("encounter_id")
  status            String    @default("CREATED")
  language          String?
  interactionMode   String?   @map("interaction_mode")
  intakeMode        String    @default("STANDARD") @map("intake_mode")
  consentGiven      Boolean   @default(false) @map("consent_given")
  consentCapturedAt DateTime? @map("consent_captured_at") @db.Timestamptz(6)
  sessionTokenHash  String?   @map("session_token_hash")
  createdByStaffUid String?   @map("created_by_staff_uid")
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)

  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages        ConversationMessage[]
  answers         IntakeAnswer[]
  clinicalHistory ClinicalHistory?

  @@index([patientId])
  @@index([status])
  @@map("intake_sessions")
}

model ConversationMessage {
  id         String   @id @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  role       String
  content    String
  inputMode  String?  @map("input_mode")
  language   String?
  questionId String?  @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session       IntakeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceAnswers IntakeAnswer[]

  @@index([sessionId])
  @@map("conversation_messages")
}

model IntakeAnswer {
  id              String   @id @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  questionId      String   @map("question_id")
  section         String
  answerType      String   @map("answer_type")
  rawValue        Json     @map("raw_value")
  certainty       String
  source          String
  sourceMessageId String?  @map("source_message_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  session       IntakeSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceMessage ConversationMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("intake_answers")
}

model ClinicalHistory {
  id               String    @id @db.Uuid
  sessionId        String    @unique @map("session_id") @db.Uuid
  patientId        Int       @map("patient_id")
  historyJson      Json      @map("history_json")
  completionStatus String    @default("INCOMPLETE") @map("completion_status")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)

  session IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([patientId])
  @@map("clinical_histories")
}
