generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id             Int             @id @default(autoincrement())
  name           String?         @db.VarChar(100)
  age            Int?
  gender         String?         @db.VarChar(10)
  phone          String?         @db.VarChar(15)
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  address        String?
  bloodGroup     String?
  email          String?
  medicalHistory String[]
  status         String          @default("Active")
  updatedAt      DateTime?       @updatedAt
  appointments   Appointment[]
  invoices       Invoice[]
  labTests       LabTest[]
  queues         Queue[]
  billing        billing[]
  lab_reports    lab_reports[]
  prescriptions  prescriptions[]

  @@map("patients")
}

model billing {
  id         Int       @id @default(autoincrement())
  patient_id Int?
  amount     Decimal?  @db.Decimal(10, 2)
  status     String?   @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  patients   Patient?  @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model doctors {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(100)
  specialization String?         @db.VarChar(100)
  phone          String?         @db.VarChar(15)
  email          String?         @db.VarChar(100)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  prescriptions  prescriptions[]
}

model lab_reports {
  id         Int       @id @default(autoincrement())
  patient_id Int?
  test_name  String?   @db.VarChar(100)
  result     String?
  file_url   String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  patients   Patient?  @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model prescriptions {
  id          Int       @id @default(autoincrement())
  patient_id  Int?
  doctor_id   Int?
  diagnosis   String?
  medicines   String?
  ai_analysis Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  doctors     doctors?  @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients    Patient?  @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Doctor {
  id             String        @id @default(uuid())
  name           String
  department     String
  specialization String
  phone          String?
  email          String?       @unique
  isAvailable    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
}

model Appointment {
  id        String   @id @default(uuid())
  patientId Int
  doctorId  String
  date      DateTime
  timeSlot  String
  status    String   @default("SCHEDULED")
  reason    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
  queues    Queue[]

  @@unique([doctorId, date, timeSlot])
}

model Queue {
  id            String      @id @default(uuid())
  patientId     Int
  appointmentId String
  doctorId      String
  status        String      @default("WAITING")
  checkInTime   DateTime    @default(now())
  completedTime DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])
}

model Medicine {
  id         String    @id @default(uuid())
  name       String
  category   String
  stock      Int       @default(0)
  price      Float     @default(0.0)
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model LabTest {
  id        String   @id @default(uuid())
  patientId Int
  testName  String
  status    String   @default("PENDING")
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Invoice {
  id        String    @id @default(uuid())
  patientId Int
  amount    Float
  status    String    @default("UNPAID")
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  patient   Patient   @relation(fields: [patientId], references: [id])
}

model Department {
  id          String  @id @default(uuid())
  name        String
  description String?
}

model Bed {
  id        String  @id @default(uuid())
  ward      String
  number    String
  status    String  @default("AVAILABLE")
  patientId String?
}
