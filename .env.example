# =============================================================================
# MEDICARE PRO — ENVIRONMENT VARIABLES MANIFEST
# Do not store production secrets or credentials in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND PREVIEW VARIABLES (Client-side / Vite)
# Injected into the browser bundle at build/dev time. Must start with VITE_.
# Belong in: Root .env or .env.local (or container build args).
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_API_PREFIX=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# 2. BACKEND & INFRASTRUCTURE VARIABLES (Node.js / Express / Docker / K8s)
# Server-only. NEVER expose these to the browser or client bundle.
# Belong in: backend/.env, docker-compose.yml, or Kubernetes Secret/ConfigMap.
# -----------------------------------------------------------------------------

# Server & Network Configuration
PORT=
NODE_ENV=
CLIENT_ORIGIN=
HTTP_PORT=

# PostgreSQL Database Configuration
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# File Storage & OCR Pipeline
UPLOAD_DIR=
MAX_FILE_SIZE_MB=
OCR_LANG=

# Authentication, RBAC & Keycloak Configuration
AUTH_ENABLED=
DEV_JWT_SECRET=
JWT_SECRET=
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URI=
KEYCLOAK_ROLES_CLAIM=
KEYCLOAK_CLIENT_ROLES_CLAIM=
JWKS_CACHE_MAX_AGE_MS=

# AI Clinical Assistant Provider
CLINICAL_ASSISTANT_PROVIDER=